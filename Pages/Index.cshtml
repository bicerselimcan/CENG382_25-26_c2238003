@page 
@model DotNetWeek5App.Pages.IndexModel
@{
    ViewData["Title"] = "Class Info - Week 6";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="row">
        <!-- LEFT SIDE: FORM -->
        <div class="col-md-5">
            <h3>@(Model.NewClass.Id == 0 ? "Add New Class" : "Edit Class")</h3>
            <form method="post">
                <input type="hidden" asp-for="NewClass.Id" />

                <div class="mb-3">
                    <label class="form-label">Class Name</label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Student Count</label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                </div>

                @if (Model.NewClass.Id == 0)
                {
                    <button type="submit" class="btn btn-primary" asp-page-handler="Add">Add Class</button>
                }
                else
                {
                    <button type="submit" class="btn btn-warning" asp-page-handler="Update">Update Class</button>
                }
            </form>
        </div>

        <!-- RIGHT SIDE: FILTER + TABLE + PAGINATION -->
        <div class="col-md-7">
            <h3>Filtered Class List</h3>

            <!-- FILTER FORM -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="Filter" value="@Model.Filter" class="form-control" placeholder="Filter by Class Name..." />
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
            </form>

            <!-- EXPORT SELECTIONS -->
            <form method="post">
                <div class="mb-2">
                    <label><strong>Select columns to export:</strong></label><br />

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="ClassName" checked id="col1" />
                        <label class="form-check-label" for="col1">Class Name</label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="StudentCount" checked id="col2" />
                            <label class="form-check-label" for="col2">Student Count</label>
                        </div>

                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="SelectedColumns" value="Description" checked id="col3" />
                            <label class="form-check-label" for="col3">Description</label>
                        </div>
                    </div>

                    <input type="hidden" name="Filter" value="@Model.Filter" />

                    <div class="mb-3">
                        <button type="submit" asp-page-handler="ExportUnfiltered" class="btn btn-success btn-sm me-2">Export All (Unfiltered)</button>
                        <button type="submit" asp-page-handler="ExportFiltered" class="btn btn-info btn-sm">Export Filtered</button>
                    </div>
                </form>

            <!-- TABLE -->
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PagedList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" asp-page-handler="Delete">Delete</button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-secondary btn-sm" asp-page-handler="Edit">Edit</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- PAGINATION -->
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" href="?Page=@i&Filter=@Model.Filter">@i</a>
                        </li>
                    }
                </ul>
            </nav>

            <!-- DEBUG -->
            <div class="text-muted mt-3">
                <strong>Debug:</strong> Page = @Model.Page, TotalPages = @Model.TotalPages, Items = @Model.PagedList.Count
            </div>
        </div>
    </div>
</div>

<style>
    .export-option {
        padding: 5px 10px;
        border-radius: 5px;
        transition: background-color 0.3s ease;
        display: inline-block;
        cursor: pointer;
    }

    .export-option input:checked + span,
    .export-option input:checked {
        background-color: #98a9bd;
        font-weight: bold;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const checkboxes = document.querySelectorAll('input[name="SelectedColumns"]');

            checkboxes.forEach(cb => {
                toggleHighlight(cb); // sayfa yüklenince de uygula

                cb.addEventListener("change", function () {
                    toggleHighlight(this);
                });
            });

            function toggleHighlight(checkbox) {
                if (checkbox.checked) {
                    checkbox.closest(".form-check").classList.add("highlighted");
                } else {
                    checkbox.closest(".form-check").classList.remove("highlighted");
                }
            }
        });
    </script>

    <style>
        .form-check.highlighted {
            background-color: #dbeafe;
            border-radius: 6px;
            padding: 6px 10px;
            transition: background-color 0.3s ease;
        }
    </style>
}